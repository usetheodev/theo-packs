{
  "name": "node-turborepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "node-turborepo",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@node-turborepo/api",
      "version": "1.0.0"
    },
    "apps/web": {
      "name": "@node-turborepo/web",
      "version": "1.0.0"
    },
    "node_modules/@node-turborepo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@node-turborepo/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@node-turborepo/utils": {
      "resolved": "packages/utils",
      "link": true
    },
    "node_modules/@node-turborepo/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/ui": {
      "name": "@node-turborepo/ui",
      "version": "1.0.0"
    },
    "packages/utils": {
      "name": "@node-turborepo/utils",
      "version": "1.0.0"
    }
  }
}
